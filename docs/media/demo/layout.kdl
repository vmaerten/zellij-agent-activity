// Three tabs, three agent sessions at different stages. `zellij:tab-bar` is the
// built-in, so this needs no plugin alias to resolve.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
    }

    tab name="api" focus=true {
        pane command="bash" {
            args "@HERE@/agent.sh" "worker"
        }
    }
    tab name="web" {
        pane command="bash" {
            args "@HERE@/agent.sh" "blocked"
        }
    }
    tab name="infra" {
        pane command="bash" {
            args "@HERE@/agent.sh" "done"
        }
    }
}
